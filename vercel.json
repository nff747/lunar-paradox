{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js|ttf|woff2|png|jpg|webp)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/labs",
      "destination": "/offline-platforms/lunar-gravity/index.html"
    },
    {
      "source": "/gravity",
      "destination": "/offline-platforms/lunar-gravity/index.html"
    },
    {
      "source": "/products",
      "destination": "/offline-platforms/lunar-astrolabe/index.html"
    },
    {
      "source": "/astrolabe",
      "destination": "/offline-platforms/lunar-astrolabe/index.html"
    },
    {
      "source": "/studio",
      "destination": "/index.html"
    }
  ]
}
