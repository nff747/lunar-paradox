{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(\\.well-known/security\\.txt|security\\.txt)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' blob: 'sha256-6akZOGEJeqXE7TijZvNPh/MQJ/bgvRk9dsR/1aRdUdk=' 'sha256-RuaWUFFzJ08jBzvC/HDtk5XLa9pruvSXG/4mOEHhDy8=' 'sha256-YcA4CT7TrAKak1/dvJMVb5KxhNc6qsX+6LOcfizbH7g=' 'sha256-mEwDzcf53NTbqvxdabs4Z5ydDVSGZogOxrFhKyIQz5s=' 'sha256-nBw0EkI8dvcTq1vzrjtMzeWKveNM/LPtG+dq1RSfd94='; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; media-src 'self' blob: data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/(.*)\\.(ttf|woff2|png|jpg|webp)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "has": [
        {
          "type": "query",
          "key": "v",
          "value": "[a-f0-9]{12}"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "has": [
        {
          "type": "host",
          "value": "www.lunarparadox.com"
        }
      ],
      "source": "/:path*",
      "destination": "https://lunarparadox.com/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/lunar-syzygy",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/lunar-syzygy/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/studio.html",
      "destination": "/studio",
      "permanent": true
    },
    {
      "source": "/gravity",
      "destination": "/labs",
      "permanent": true
    },
    {
      "source": "/astrolabe",
      "destination": "/products",
      "permanent": true
    },
    {
      "source": "/platforms/gravity/:path*",
      "destination": "https://labs.lunarparadox.com",
      "permanent": true
    },
    {
      "source": "/platforms/astrolabe/:path*",
      "destination": "https://products.lunarparadox.com",
      "permanent": true
    },
    {
      "source": "/platforms/syzygy/:path*",
      "destination": "https://lunarparadox.com",
      "permanent": true
    },
    {
      "has": [
        {
          "type": "host",
          "value": "labs.lunarparadox.com"
        }
      ],
      "source": "/labs",
      "destination": "/",
      "permanent": true
    },
    {
      "has": [
        {
          "type": "host",
          "value": "labs.lunarparadox.com"
        }
      ],
      "source": "/labs/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "has": [
        {
          "type": "host",
          "value": "products.lunarparadox.com"
        }
      ],
      "source": "/products",
      "destination": "/",
      "permanent": true
    },
    {
      "has": [
        {
          "type": "host",
          "value": "products.lunarparadox.com"
        }
      ],
      "source": "/products/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "has": [
        {
          "type": "host",
          "value": "studio.lunarparadox.com"
        }
      ],
      "source": "/studio",
      "destination": "/",
      "permanent": true
    },
    {
      "has": [
        {
          "type": "host",
          "value": "studio.lunarparadox.com"
        }
      ],
      "source": "/studio/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/[...path]?path=:path*"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "studio.lunarparadox.com"
        }
      ],
      "source": "/",
      "destination": "/studio.html"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "labs.lunarparadox.com"
        }
      ],
      "source": "/",
      "destination": "/lunar-gravity/index.html"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "products.lunarparadox.com"
        }
      ],
      "source": "/",
      "destination": "/lunar-astrolabe/index.html"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "products.lunarparadox.com"
        }
      ],
      "source": "/pbr-synth",
      "destination": "/lunar-astrolabe/tools/pbr-synth/index.html"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "products.lunarparadox.com"
        }
      ],
      "source": "/pbr-synth/:path*",
      "destination": "/lunar-astrolabe/tools/pbr-synth/:path*"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "products.lunarparadox.com"
        }
      ],
      "source": "/optim-compressor",
      "destination": "/lunar-astrolabe/tools/optim-compressor/index.html"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "products.lunarparadox.com"
        }
      ],
      "source": "/optim-compressor/:path*",
      "destination": "/lunar-astrolabe/tools/optim-compressor/:path*"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "products.lunarparadox.com"
        }
      ],
      "source": "/resonance-dsp",
      "destination": "/lunar-astrolabe/tools/resonance-dsp/index.html"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "products.lunarparadox.com"
        }
      ],
      "source": "/resonance-dsp/:path*",
      "destination": "/lunar-astrolabe/tools/resonance-dsp/:path*"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "products.lunarparadox.com"
        }
      ],
      "source": "/cipher-workbench",
      "destination": "/lunar-astrolabe/tools/cipher-workbench/index.html"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "products.lunarparadox.com"
        }
      ],
      "source": "/cipher-workbench/:path*",
      "destination": "/lunar-astrolabe/tools/cipher-workbench/:path*"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "labs.lunarparadox.com"
        }
      ],
      "source": "/labs/:path*",
      "destination": "/lunar-gravity/:path*"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "products.lunarparadox.com"
        }
      ],
      "source": "/products/:path*",
      "destination": "/lunar-astrolabe/:path*"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "studio.lunarparadox.com"
        }
      ],
      "source": "/:path*",
      "destination": "/lunar-syzygy/:path*"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "labs.lunarparadox.com"
        }
      ],
      "source": "/:path*",
      "destination": "/lunar-gravity/:path*"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "products.lunarparadox.com"
        }
      ],
      "source": "/:path*",
      "destination": "/lunar-astrolabe/:path*"
    },
    {
      "source": "/",
      "destination": "/lunar-syzygy/index.html"
    },
    {
      "source": "/studio",
      "destination": "/studio.html"
    },
    {
      "source": "/labs",
      "destination": "/lunar-gravity/index.html"
    },
    {
      "source": "/labs/:path*",
      "destination": "/lunar-gravity/:path*"
    },
    {
      "source": "/products",
      "destination": "/lunar-astrolabe/index.html"
    },
    {
      "source": "/products/:path*",
      "destination": "/lunar-astrolabe/:path*"
    },
    {
      "source": "/pbr-synth",
      "destination": "/lunar-astrolabe/tools/pbr-synth/index.html"
    },
    {
      "source": "/pbr-synth/:path*",
      "destination": "/lunar-astrolabe/tools/pbr-synth/:path*"
    },
    {
      "source": "/optim-compressor",
      "destination": "/lunar-astrolabe/tools/optim-compressor/index.html"
    },
    {
      "source": "/optim-compressor/:path*",
      "destination": "/lunar-astrolabe/tools/optim-compressor/:path*"
    },
    {
      "source": "/resonance-dsp",
      "destination": "/lunar-astrolabe/tools/resonance-dsp/index.html"
    },
    {
      "source": "/resonance-dsp/:path*",
      "destination": "/lunar-astrolabe/tools/resonance-dsp/:path*"
    },
    {
      "source": "/cipher-workbench",
      "destination": "/lunar-astrolabe/tools/cipher-workbench/index.html"
    },
    {
      "source": "/cipher-workbench/:path*",
      "destination": "/lunar-astrolabe/tools/cipher-workbench/:path*"
    },
    {
      "source": "/tools/:path*",
      "destination": "/lunar-astrolabe/tools/:path*"
    },
    {
      "source": "/security.txt",
      "destination": "/.well-known/security.txt"
    }
  ],
  "buildCommand": "npm run build -- --hosted-only",
  "outputDirectory": "build/hosted",
  "functions": {
    "api/[...path].js": {
      "maxDuration": 15
    }
  }
}
