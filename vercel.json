{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' blob: 'sha256-61jmFeGADcXWpB9OwLOmVsOfjUEyAOsOB42z0OYNHnw=' 'sha256-LUWHc7kp5xXG7gIX0kdqEGzkPC2aRDhyvFDLpTxPPbU=' 'sha256-S4CVmWQkNCYuOQlidkJkHR03V4j5fSAEwPyAMCHmbkA=' 'sha256-SOsKqbWXXxBExwTvAQqibrqD8U7vg+S4dGjRq+67AMU=' 'sha256-rn32tCG3UFkI+k4LEal+SpHjGcbZ11ZYbmjvvH4qnvQ='; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; media-src 'self' blob: data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/(.*)\\.(ttf|woff2|png|jpg|webp)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "has": [
        {
          "type": "query",
          "key": "v",
          "value": "[a-f0-9]{12}"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "has": [
        {
          "type": "host",
          "value": "www.lunarparadox.com"
        }
      ],
      "source": "/:path*",
      "destination": "https://lunarparadox.com/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/lunar-syzygy",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/lunar-syzygy/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/studio.html",
      "destination": "/studio",
      "permanent": true
    },
    {
      "source": "/gravity",
      "destination": "/labs",
      "permanent": true
    },
    {
      "source": "/astrolabe",
      "destination": "/products",
      "permanent": true
    },
    {
      "source": "/platforms/gravity/:path*",
      "destination": "https://labs.lunarparadox.com",
      "permanent": true
    },
    {
      "source": "/platforms/astrolabe/:path*",
      "destination": "https://products.lunarparadox.com",
      "permanent": true
    },
    {
      "source": "/platforms/syzygy/:path*",
      "destination": "https://lunarparadox.com",
      "permanent": true
    },
    {
      "has": [
        {
          "type": "host",
          "value": "labs.lunarparadox.com"
        }
      ],
      "source": "/labs",
      "destination": "/",
      "permanent": true
    },
    {
      "has": [
        {
          "type": "host",
          "value": "products.lunarparadox.com"
        }
      ],
      "source": "/products",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/[...path]?path=:path*"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "labs.lunarparadox.com"
        }
      ],
      "source": "/",
      "destination": "/lunar-gravity/index.html"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "products.lunarparadox.com"
        }
      ],
      "source": "/",
      "destination": "/lunar-astrolabe/index.html"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "labs.lunarparadox.com"
        }
      ],
      "source": "/labs/:path*",
      "destination": "/lunar-gravity/:path*"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "products.lunarparadox.com"
        }
      ],
      "source": "/products/:path*",
      "destination": "/lunar-astrolabe/:path*"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "labs.lunarparadox.com"
        }
      ],
      "source": "/:path*",
      "destination": "/lunar-gravity/:path*"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "products.lunarparadox.com"
        }
      ],
      "source": "/:path*",
      "destination": "/lunar-astrolabe/:path*"
    },
    {
      "source": "/",
      "destination": "/lunar-syzygy/index.html"
    },
    {
      "source": "/studio",
      "destination": "/studio.html"
    },
    {
      "source": "/labs",
      "destination": "/lunar-gravity/index.html"
    },
    {
      "source": "/labs/:path*",
      "destination": "/lunar-gravity/:path*"
    },
    {
      "source": "/products",
      "destination": "/lunar-astrolabe/index.html"
    },
    {
      "source": "/products/:path*",
      "destination": "/lunar-astrolabe/:path*"
    }
  ],
  "buildCommand": "npm run build -- --hosted-only",
  "outputDirectory": "build/hosted",
  "functions": {
    "api/[...path].js": {
      "maxDuration": 15
    }
  }
}
