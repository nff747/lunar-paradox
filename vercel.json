{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js|ttf|woff2|png|jpg|webp)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "has": [
        {
          "type": "host",
          "value": "labs.lunarparadox.com"
        }
      ],
      "source": "/:path*",
      "destination": "https://lunarparadox.com/labs/:path*",
      "permanent": false
    },
    {
      "has": [
        {
          "type": "host",
          "value": "products.lunarparadox.com"
        }
      ],
      "source": "/:path*",
      "destination": "https://lunarparadox.com/products/:path*",
      "permanent": false
    },
    {
      "has": [
        {
          "type": "host",
          "value": "studio.lunarparadox.com"
        }
      ],
      "source": "/:path*",
      "destination": "https://lunarparadox.com/studio/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/labs",
      "destination": "/offline-platforms/lunar-gravity/index.html"
    },
    {
      "source": "/labs/:path*",
      "destination": "/offline-platforms/lunar-gravity/:path*"
    },
    {
      "source": "/gravity",
      "destination": "/offline-platforms/lunar-gravity/index.html"
    },
    {
      "source": "/gravity/:path*",
      "destination": "/offline-platforms/lunar-gravity/:path*"
    },
    {
      "source": "/products",
      "destination": "/offline-platforms/lunar-astrolabe/index.html"
    },
    {
      "source": "/products/:path*",
      "destination": "/offline-platforms/lunar-astrolabe/:path*"
    },
    {
      "source": "/astrolabe",
      "destination": "/offline-platforms/lunar-astrolabe/index.html"
    },
    {
      "source": "/astrolabe/:path*",
      "destination": "/offline-platforms/lunar-astrolabe/:path*"
    },
    {
      "source": "/studio",
      "destination": "/index.html"
    },
    {
      "source": "/studio/:path*",
      "destination": "/index.html"
    }
  ]
}
