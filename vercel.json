{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(\\.well-known/security\\.txt|security\\.txt)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' blob: 'sha256-1W94YnHxt2+ZOZLy3l1xbwptDD5teMjRqrxPqNATk38=' 'sha256-8oczD3UU30+2YLzFyVr6cb2GWgsHettfBhSZ7fyt/iE=' 'sha256-BjH827I4MJFlVV4hzxSjRJl9WbU1UyOm+wW+rx0qiCs=' 'sha256-Ln73pnDDtC115d9gvdprG+kx2qpC6vV1Cma8WNu1ipg=' 'sha256-LnEjGUBnq1RbTID9/Rkb6tBtFyBGeQzLQFot3VVHegg=' 'sha256-MfhFkD0Sg8qhwbzuVP4/pNwb/wYWUP35NG5Z1+hXSnw=' 'sha256-Nz7ayCGBH8A/qkoInt7PhAiAkubtvfO+NBEpP9Z5K34=' 'sha256-QVI29Z7XIqPIn0HJ2xyklduRUMCa8u1UEX2vyQJZcnc=' 'sha256-W5QsmWb6XxfFLqEsBwMDJHyF6fEG73/fdYWwPy0nXwk=' 'sha256-ZjgkDxcQrhtvykU3t9kbt9BJ1mWrI1lol34b1Y3mB1A=' 'sha256-gp1ZyHPmcb2+VP0ttzMFDBM4SrqIcSLXbH3i/vh9zzI=' 'sha256-loLdQ8aDy1Ar99sbLQhkpN5GbTuDJoDRWSh6HEwCGQ4=' 'sha256-nQSgKYIeRMF4+mfpfEUMyDrT9vYSXuKec2I60TRjW/8=' 'sha256-pdXx+rVr938y3jzZ2Tl1I7WuK3xATHOUo9/Bu1jj0jU=' 'sha256-qAG5gRAYPT1Al+SSxq2x2TWcBcyTgkRVe38urnfMzHs=' 'sha256-zaWLOPS9oElm0+mH9mjckU9K1B/3b7/E9l5VIXi7jpQ=' 'sha256-zuZZ8r+E1Gitg5ldW6k0H+v6aalfRh0qOo7CMiGKb9o='; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; media-src 'self' blob: data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/(.*)\\.(ttf|woff2|png|jpg|webp|svg|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "has": [
        {
          "type": "query",
          "key": "v",
          "value": "[a-f0-9]{12}"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/operations(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
