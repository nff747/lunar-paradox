{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "lunarparradox.com"
        }
      ],
      "destination": "https://lunarparadox.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.lunarparradox.com"
        }
      ],
      "destination": "https://lunarparadox.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "labs.lunarparradox.com"
        }
      ],
      "destination": "https://labs.lunarparadox.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "products.lunarparradox.com"
        }
      ],
      "destination": "https://products.lunarparadox.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "studio.lunarparradox.com"
        }
      ],
      "destination": "https://studio.lunarparadox.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "labs.lunarparadox.com"
        }
      ],
      "destination": "/labs/$1"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "products.lunarparadox.com"
        }
      ],
      "destination": "/products/$1"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "studio.lunarparadox.com"
        }
      ],
      "destination": "/studio/$1"
    },
    {
      "source": "/platforms/gravity/(.*)",
      "destination": "/labs/$1"
    },
    {
      "source": "/platforms/gravity",
      "destination": "/labs/index.html"
    },
    {
      "source": "/platforms/astrolabe/(.*)",
      "destination": "/products/$1"
    },
    {
      "source": "/platforms/astrolabe",
      "destination": "/products/index.html"
    },
    {
      "source": "/platforms/syzygy/(.*)",
      "destination": "/studio/$1"
    },
    {
      "source": "/platforms/syzygy",
      "destination": "/studio/index.html"
    },
    {
      "source": "/labs",
      "destination": "/labs/index.html"
    },
    {
      "source": "/products",
      "destination": "/products/index.html"
    },
    {
      "source": "/studio",
      "destination": "/studio/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|svg|gif|ttf|woff|woff2|mp3|ogg|wav)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
